
#Область РегламентныеПроцедуры

// Автоматически проверяет текущие остатки товаров.
// При обнаружении отрицательного остатка записывает предупреждение в журнал регистрации.
Процедура ПроверитьОтрицательныеОстатки() Экспорт
	
	#Область ПолучениеОстатков
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ОстаткиТоваровОстатки.Товар КАК Товар,
	|	ОстаткиТоваровОстатки.КоличествоОстаток КАК КоличествоОстаток
	|ИЗ
	|	РегистрНакопления.ОстаткиТоваров.Остатки(&МоментКонтроля) КАК ОстаткиТоваровОстатки
	|ГДЕ
	|	ОстаткиТоваровОстатки.КоличествоОстаток < 0";
	
	Запрос.УстановитьПараметр("МоментКонтроля", ТекущаяДата());
	
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаОстатков = РезультатЗапроса.Выбрать();
	
	#КонецОбласти
	
	#Область РегистрацияНарушений
	
	Пока ВыборкаОстатков.Следующий() Цикл
		
		ТекстСообщения = СтрШаблон(
			"Обнаружен отрицательный остаток товара ""%1"": %2.",
			Строка(ВыборкаОстатков.Товар),
			Строка(ВыборкаОстатков.КоличествоОстаток)
		);
		
		// Записываем отдельное предупреждение для каждого товара.
		ЗаписьЖурналаРегистрации(
			"МиниСклад.КонтрольОстатков",
			УровеньЖурналаРегистрации.Предупреждение,
			Метаданные.РегистрыНакопления.ОстаткиТоваров,
			ВыборкаОстатков.Товар,
			ТекстСообщения
		);
		
	КонецЦикла;
	
	#КонецОбласти
	
КонецПроцедуры

#КонецОбласти
