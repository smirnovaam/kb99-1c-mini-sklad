#Область ОбработчикиЗапросов

// GET отдает актуальные остатки товаров в формате JSON
Функция ОстаткиПолучитьОстатки(Запрос)
	
	МассивТоваров = ПолучитьДанныеТоваровДляВыгрузки();
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ПараметрыJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто);
	ЗаписьJSON.УстановитьСтроку(ПараметрыJSON);
	
	ЗаписатьJSON(ЗаписьJSON, МассивТоваров);
	ТекстJSON = ЗаписьJSON.Закрыть();
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(ТекстJSON, КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	
	Возврат Ответ;
	
КонецФункции

// POST принимает JSON, создает и проводит ПоступлениеТоваров
Функция ПоступленияСоздатьПоступление(Запрос)
	
	ТекстЗапроса = Запрос.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	
	Попытка
		
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(ТекстЗапроса);
		// Второй параметр Истина означает, что JSON-объекты читаются как Соответствие
		ДанныеПоступления = ПрочитатьJSON(ЧтениеJSON, Истина);
		ЧтениеJSON.Закрыть();
		
		НомерДокумента = СоздатьИПровестиПоступление(ДанныеПоступления);
		
		ОтветСтруктура = Новый Структура("status, documentNumber", "ok", НомерДокумента);
		КодОтвета = 201; // 201 Created — документ успешно создан
		
	Исключение
		
		ОтветСтруктура = Новый Структура("status, error", "error", ОписаниеОшибки());
		КодОтвета = 400; // 400 Bad Request — ошибка в данных или проведении
		
	КонецПопытки;
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, ОтветСтруктура);
	
	Ответ = Новый HTTPСервисОтвет(КодОтвета);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.УстановитьТелоИзСтроки(ЗаписьJSON.Закрыть(), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	
	Возврат Ответ;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьДанныеТоваровДляВыгрузки()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Товары.Код КАК Код,
		|	Товары.Наименование КАК Наименование,
		|	ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК Остаток
		|ИЗ
		|	Справочник.Товары КАК Товары
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваров.Остатки КАК Остатки
		|		ПО Товары.Ссылка = Остатки.Товар
		|ГДЕ
		|	НЕ Товары.ПометкаУдаления
		|УПОРЯДОЧИТЬ ПО
		|	Товары.Наименование";
	
	Выборка = Запрос.Выполнить().Выбрать();
	МассивРезультата = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		ОписаниеТовара = Новый Структура;
		ОписаниеТовара.Вставить("code", СокрЛП(Выборка.Код));
		ОписаниеТовара.Вставить("name", СокрЛП(Выборка.Наименование));
		ОписаниеТовара.Вставить("stock", Выборка.Остаток);
		МассивРезультата.Добавить(ОписаниеТовара);
	КонецЦикла;
	
	Возврат МассивРезультата;
	
КонецФункции

Функция СоздатьИПровестиПоступление(ДанныеПоступления)
	
	Если ТипЗнч(ДанныеПоступления) <> Тип("Соответствие") Тогда
		ВызватьИсключение "Некорректный формат входящего JSON.";
	КонецЕсли;
	
	ИмяПоставщика = ДанныеПоступления.Получить("supplier");
	Если Не ЗначениеЗаполнено(ИмяПоставщика) Тогда
		ВызватьИсключение "Не указан поставщик (поле supplier).";
	КонецЕсли;
	
	ПоставщикСсылка = Справочники.Контрагенты.НайтиПоНаименованию(СокрЛП(ИмяПоставщика));
	Если Не ЗначениеЗаполнено(ПоставщикСсылка) Тогда
		ВызватьИсключение СтрШаблон("Контрагент ""%1"" не найден в справочнике!", ИмяПоставщика);
	КонецЕсли;
	
	СтрокиТоваров = ДанныеПоступления.Получить("items");
	Если ТипЗнч(СтрокиТоваров) <> Тип("Массив") Или СтрокиТоваров.Количество() = 0 Тогда
		ВызватьИсключение "Не передан список товаров (массив items пуст).";
	КонецЕсли;
	
	НовыйДокумент = Документы.ПоступлениеТоваров.СоздатьДокумент();
	НовыйДокумент.Дата = ТекущаяДатаСеанса();
	НовыйДокумент.Контрагент = ПоставщикСсылка;
	
	Для Каждого СтрокаJSON Из СтрокиТоваров Цикл
		
		КодТовара = СокрЛП(Строка(СтрокаJSON.Получить("code")));
		ТоварСсылка = Справочники.Товары.НайтиПоКоду(КодТовара);
		
		Если Не ЗначениеЗаполнено(ТоварСсылка) Тогда
			ВызватьИсключение СтрШаблон("Товар с кодом ""%1"" не найден в базе!", КодТовара);
		КонецЕсли;
		
		НоваяСтрока = НовыйДокумент.Товары.Добавить();
		НоваяСтрока.Товар = ТоварСсылка;
		НоваяСтрока.Количество = СтрокаJSON.Получить("qty");
		НоваяСтрока.Цена = СтрокаJSON.Получить("price");
		НоваяСтрока.Сумма = НоваяСтрока.Количество * НоваяСтрока.Цена;
		
	КонецЦикла;
	
	// Проводим документ — автоматически запишутся остатки и FIFO-партии
	НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
	
	Возврат СокрЛП(НовыйДокумент.Номер);
	
КонецФункции

#КонецОбласти
