#Область ОбработчикиСобытий

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	// 1. Проверяем, что табличная часть не пустая
	Если Товары.Количество() = 0 Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не заполнена табличная часть ""Товары""!";
		Сообщение.Поле = "Товары";
		Сообщение.Сообщить();
		
		Отказ = Истина;
		Возврат;
		
	КонецЕсли;
	
	// 2. Проверяем корректность цифр в каждой строке табличной части
	Для Каждого ТекСтрокаТовары Из Товары Цикл
		
		ИндексСтроки = Товары.Индекс(ТекСтрокаТовары);
		
		Если ТекСтрокаТовары.Количество <= 0 Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон("В строке %1 количество товара должно быть больше нуля.", ИндексСтроки + 1);
			Сообщение.Поле = "Товары[" + ИндексСтроки + "].Количество";
			Сообщение.Сообщить();
			Отказ = Истина;
		КонецЕсли;
		
		Если ТекСтрокаТовары.Цена <= 0 Тогда
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = СтрШаблон("В строке %1 не указана цена продажи товара.", ИндексСтроки + 1);
			Сообщение.Поле = "Товары[" + ИндексСтроки + "].Цена";
			Сообщение.Сообщить();
			Отказ = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	#Область ИнициализацияДвижений
	
	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.СтоимостьМатериалов.Записывать = Истина; 
	Движения.Продажи.Записывать = Истина;
	Движения.ПартииТоваров.Записывать = Истина;
	
	#КонецОбласти
	
	#Область ПолучениеДанных
	
	ВыборкаПартий = ПолучитьВыборкуДоступныхПартий(ЭтотОбъект);
	
	#КонецОбласти
	
	#Область ПервыйПроход_ПроверкаОстатков
	
	// Сначала проверяем остатки по ВСЕМ строкам, не формируя движений
	ЕстьНехватка = Ложь;
	
	Для Каждого ТекСтрокаТовары Из Товары Цикл
		
		Если Не ЗначениеЗаполнено(ТекСтрокаТовары.Товар) Тогда
			Продолжить;
		КонецЕсли;
		
		ДоступныйОстаток = РассчитатьДоступныйОстаток(ТекСтрокаТовары.Товар, ВыборкаПартий);
		
		Если ТекСтрокаТовары.Количество > ДоступныйОстаток Тогда
			
			ТекстСообщения = СтрШаблон(
			"Недостаточно товара ""%1"". Требуется: %2, доступно: %3", 
			ТекСтрокаТовары.Товар, 
			ТекСтрокаТовары.Количество,
			ДоступныйОстаток
			);
			
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = ТекстСообщения;
			Сообщение.Поле = "Товары[" + ТекСтрокаТовары.Индекс() + "].Товар";
			Сообщение.УстановитьДанные(ЭтотОбъект);
			Сообщение.Сообщить();
			
			ЕстьНехватка = Истина;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ЕстьНехватка Тогда
		Отказ = Истина;
		Возврат; // Выходим, движения не формируем
	КонецЕсли;
	
	#КонецОбласти
	
	#Область ВторойПроход_ФормированиеДвижений
	
	// Все остатки проверены, если нехватки нет, то формируем движения
	ВыборкаПартий.Сбросить();
	
	Для Каждого ТекСтрокаТовары Из Товары Цикл
		
		Если Не ЗначениеЗаполнено(ТекСтрокаТовары.Товар) Тогда
			Продолжить;
		КонецЕсли;
		
		СебестоимостьСписания = СформироватьДвиженияПоПартиям(ТекСтрокаТовары, ВыборкаПартий);
		
		// Регистр ОстаткиТоваров
		ДвижениеОстатки = Движения.ОстаткиТоваров.Добавить();
		ДвижениеОстатки.ВидДвижения = ВидДвиженияНакопления.Расход;
		ДвижениеОстатки.Период = Дата;
		ДвижениеОстатки.Товар = ТекСтрокаТовары.Товар;
		ДвижениеОстатки.Количество = ТекСтрокаТовары.Количество;
		
		// Регистр СтоимостьМатериалов
		ДвижениеСтоимость = Движения.СтоимостьМатериалов.Добавить();
		ДвижениеСтоимость.ВидДвижения = ВидДвиженияНакопления.Расход;
		ДвижениеСтоимость.Период = Дата;
		ДвижениеСтоимость.Товар = ТекСтрокаТовары.Товар;
		ДвижениеСтоимость.Стоимость = СебестоимостьСписания;
		
		// Регистр Продажи
		ДвижениеПродажи = Движения.Продажи.Добавить();
		ДвижениеПродажи.Период = Дата;
		ДвижениеПродажи.Товар = ТекСтрокаТовары.Товар;
		ДвижениеПродажи.Контрагент = Контрагент;
		ДвижениеПродажи.Количество = ТекСтрокаТовары.Количество;
		ДвижениеПродажи.Выручка = ТекСтрокаТовары.Сумма;
		ДвижениеПродажи.Стоимость = СебестоимостьСписания;
		
	КонецЦикла;
	
	#КонецОбласти
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Подсчитывает доступный остаток по товару, не изменяя курсор выборки
Функция РассчитатьДоступныйОстаток(Товар, ВыборкаПартий)
	
	ДоступныйОстаток = 0;
	
	// Сохраняем текущую позицию выборки
	// (НайтиСледующий сам корректно работает, но для подсчёта делаем отдельный проход)
	СтруктураОтбора = Новый Структура("Товар", Товар);
	ВыборкаПартий.Сбросить();
	
	Пока ВыборкаПартий.НайтиСледующий(СтруктураОтбора) Цикл
		ДоступныйОстаток = ДоступныйОстаток + ВыборкаПартий.КоличествоОстаток;
	КонецЦикла;
	
	Возврат ДоступныйОстаток;
	
КонецФункции

// Формирует движения по регистру ПартииТоваров и возвращает себестоимость списания
Функция СформироватьДвиженияПоПартиям(ТекСтрокаТовары, ВыборкаПартий)
	
	НеобходимоеКоличество = ТекСтрокаТовары.Количество;
	СебестоимостьСписания = 0;
	
	СтруктураОтбора = Новый Структура("Товар", ТекСтрокаТовары.Товар);
	
	Пока ВыборкаПартий.НайтиСледующий(СтруктураОтбора) Цикл
		
		Если НеобходимоеКоличество <= 0 Тогда
			Прервать;
		КонецЕсли;
		
		КоличествоСПартии = Мин(НеобходимоеКоличество, ВыборкаПартий.КоличествоОстаток);
		
		Если ВыборкаПартий.КоличествоОстаток > 0 Тогда
			УдельнаяСтоимость = ВыборкаПартий.СебестоимостьОстаток / ВыборкаПартий.КоличествоОстаток;
		Иначе
			УдельнаяСтоимость = 0;
		КонецЕсли;
		
		СуммаСписанияСПартии = УдельнаяСтоимость * КоличествоСПартии;
		СебестоимостьСписания = СебестоимостьСписания + СуммаСписанияСПартии;
		
		ЗаписьПартии = Движения.ПартииТоваров.Добавить();
		ЗаписьПартии.ВидДвижения = ВидДвиженияНакопления.Расход;
		ЗаписьПартии.Период = Дата;
		ЗаписьПартии.Товар = ВыборкаПартий.Товар;
		ЗаписьПартии.Партия = ВыборкаПартий.Партия;
		ЗаписьПартии.Количество = КоличествоСПартии;
		ЗаписьПартии.Себестоимость = СуммаСписанияСПартии;
		
		НеобходимоеКоличество = НеобходимоеКоличество - КоличествоСПартии;
		
	КонецЦикла;
	
	Возврат СебестоимостьСписания;
	
КонецФункции

Функция ПолучитьВыборкуДоступныхПартий(ДокументОбъект)
	
	ТоварыДляЗапроса = ДокументОбъект.Товары.ВыгрузитьКолонку("Товар");
	
	ПартииТоваровЗапрос = Новый Запрос;
	ПартииТоваровЗапрос.Текст = 
	"ВЫБРАТЬ
	|	ПартииТоваров.Товар КАК Товар,
	|	ПартииТоваров.Партия КАК Партия,
	|	ПартииТоваров.КоличествоОстаток КАК КоличествоОстаток,
	|	ПартииТоваров.СебестоимостьОстаток КАК СебестоимостьОстаток
	|ИЗ
	|	РегистрНакопления.ПартииТоваров.Остатки(&Дата, Товар В(&ТоварыДляЗапроса)) КАК ПартииТоваров
	|УПОРЯДОЧИТЬ ПО
	|	ПартииТоваров.Товар,
	|	ПартииТоваров.Партия.Дата ВОЗР,
	|	ПартииТоваров.Партия ВОЗР";
	
	ПартииТоваровЗапрос.УстановитьПараметр("Дата", ДокументОбъект.Дата);
	ПартииТоваровЗапрос.УстановитьПараметр("ТоварыДляЗапроса", ТоварыДляЗапроса);
	
	Возврат ПартииТоваровЗапрос.Выполнить().Выбрать();
	
КонецФункции

#КонецОбласти
