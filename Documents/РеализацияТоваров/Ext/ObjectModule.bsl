#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, Режим)
	
	#Область ИнициализацияДвижений
	
	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.СтоимостьМатериалов.Записывать = Истина; 
	Движения.Продажи.Записывать = Истина;
	Движения.ПартииТоваров.Записывать = Истина; 
	
	#КонецОбласти
	
	#Область ПолучениеДанных
	
	// Получаем выборку партий, упорядоченную по FIFO (Товар, Период)
	ВыборкаПартий = ПолучитьВыборкуДоступныхПартий(ЭтотОбъект);
	
	#КонецОбласти     
	
	#Область ФормированиеДвижений
	
	Для Каждого ТекСтрокаТовары Из Товары Цикл 
		
		// Охранное условие: пропускаем пустые строки
		Если Не ЗначениеЗаполнено(ТекСтрокаТовары.Товар) Тогда
			Продолжить;
		КонецЕсли;
		
		НеобходимоеКоличество = ТекСтрокаТовары.Количество;
		СебестоимостьСписания = 0;    
		
		ВыборкаПартий.Сбросить();
		СтруктураОтбора = Новый Структура("Товар", ТекСтрокаТовары.Товар);
		
		// Алгоритм списания партий по FIFO
		Пока ВыборкаПартий.НайтиСледующий(СтруктураОтбора) Цикл
			
			Если НеобходимоеКоличество <= 0 Тогда
				Прервать;
			КонецЕсли;
			
			КоличествоСПартии = Мин(НеобходимоеКоличество, ВыборкаПартий.КоличествоОстаток);
			
			// Расчет стоимости списания с текущей партии накопления
			Если ВыборкаПартий.КоличествоОстаток > 0 Тогда
				УдельнаяСтоимость = ВыборкаПартий.СебестоимостьОстаток / ВыборкаПартий.КоличествоОстаток;
			Иначе
				УдельнаяСтоимость = 0;
			КонецЕсли;
			
			СтоимостьСписанияСПартии = УдельнаяСтоимость * КоличествоСПартии;
			СебестоимостьСписания = СебестоимостьСписания + СтоимостьСписанияСПартии;
			
			// Фиксируем уменьшение остатка партии в новом регистре накопления (значения ПОЛОЖИТЕЛЬНЫЕ)
			ЗаписьПартии = Движения.ПартииТоваров.Добавить(); 
			ЗаписьПартии.ВидДвижения = ВидДвиженияНакопления.Расход;
			ЗаписьПартии.Период = Дата;
			ЗаписьПартии.Товар = ВыборкаПартий.Товар;
			ЗаписьПартии.Партия = ВыборкаПартий.Партия;
			ЗаписьПартии.Количество = КоличествоСПартии;
			ЗаписьПартии.Себестоимость = СтоимостьСписанияСПартии; 
			
			НеобходимоеКоличество = НеобходимоеКоличество - КоличествоСПартии;
			
		КонецЦикла;	
		
		#Область ПроверкаОтрицательныхОстатков
		
		Если НеобходимоеКоличество > 0 И Режим = РежимПроведенияДокумента.Оперативный Тогда
			
			ТекстСообщения = СтрШаблон(
				"Недостаточно товара ""%1"" по партиям. Не хватает %2 шт.!", 
				ТекСтрокаТовары.Товар, 
				НеобходимоеКоличество
			);
			
			
			ИндексСтроки = Товары.Индекс(ТекСтрокаТовары);
			
			Сообщение = Новый СообщениеПользователю;
			Сообщение.Текст = ТекстСообщения; 
			Сообщение.Поле = "Товары[" + ИндексСтроки + "].Товар"; 
			Сообщение.Сообщить();
			
			Отказ = Истина;
			
		КонецЕсли;
		
		#КонецОбласти   
		
		Если Отказ Тогда
			Продолжить;
		КонецЕсли;
		
		// Запись движений в остальные регистры накопления
		
		// регистр ОстаткиТоваров Расход
		Движение = Движения.ОстаткиТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Товар = ТекСтрокаТовары.Товар;
		Движение.Количество = ТекСтрокаТовары.Количество;
		
		// регистр СтоимостьМатериалов Расход
		Движение = Движения.СтоимостьМатериалов.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
		Движение.Период = Дата;
		Движение.Товар = ТекСтрокаТовары.Товар;
		Движение.Стоимость = ТекСтрокаТовары.Сумма;
		
		// Регистр Продажи
		Движение = Движения.Продажи.Добавить();
		Движение.Период = Дата;
		Движение.Товар = ТекСтрокаТовары.Товар;
		Движение.Контрагент = Контрагент;
		Движение.Количество = ТекСтрокаТовары.Количество;
		Движение.Выручка = ТекСтрокаТовары.Сумма;
		Движение.Стоимость = 
		ТекСтрокаТовары.Стоимость * 
		ТекСтрокаТовары.Количество;   
	КонецЦикла; 
	
	#КонецОбласти
	
КонецПроцедуры 

#КонецОбласти    

#Область СлужебныеПроцедурыИФункции

Функция ПолучитьВыборкуДоступныхПартий(ДокументОбъект)
	
	ТоварыДляЗапроса = ДокументОбъект.Товары.ВыгрузитьКолонку("Товар");
	
	ПартииТоваровЗапрос = Новый Запрос;
	ПартииТоваровЗапрос.Текст = 
		"ВЫБРАТЬ
		|	ПартииТоваровОстатки.Товар КАК Товар,
		|	ПартииТоваровОстатки.Партия КАК Партия,
		|	ПартииТоваровОстатки.КоличествоОстаток КАК КоличествоОстаток,
		|	ПартииТоваровОстатки.СебестоимостьОстаток КАК СебестоимостьОстаток
		|ИЗ
		|	РегистрНакопления.ПартииТоваров.Остатки(&МоментВремени, Товар В (&ТоварыДляЗапроса)) КАК ПартииТоваровОстатки
		|УПОРЯДОЧИТЬ ПО
		|	Товар,
		|	ПартииТоваровОстатки.Партия.МоментВремени ВОЗР";
	
	ПартииТоваровЗапрос.УстановитьПараметр("МоментВремени", ДокументОбъект.МоментВремени());
	ПартииТоваровЗапрос.УстановитьПараметр("ТоварыДляЗапроса", ТоварыДляЗапроса);
	
	Возврат ПартииТоваровЗапрос.Выполнить().Выбрать();
	
КонецФункции

#КонецОбласти