#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Подбор(Команда)
	
	ПараметрыФормы = Новый Структура("ЗакрыватьПриВыборе, МножественныйВыбор", Ложь, Истина);
	ОткрытьФорму("Справочник.Товары.ФормаВыбора", ПараметрыФормы, Элементы.Товары);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ТоварыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	// 1. Собираем массив уникальных товаров из выбора
	МассивТоваров = Новый Массив;
	Для Каждого ВыбранныйТовар Из ВыбранноеЗначение Цикл
		Если МассивТоваров.Найти(ВыбранныйТовар) = Неопределено Тогда
			МассивТоваров.Добавить(ВыбранныйТовар);
		КонецЕсли;
	КонецЦикла;
	
	// 2. ОДИН серверный вызов для получения себестоимостей всех товаров сразу
	Себестоимости = ПолучитьСебестоимостиТоваровНаСервере(МассивТоваров);
	
	// 3. На клиенте заполняем строки, используя полученные данные
	Для Каждого ВыбранныйТовар Из ВыбранноеЗначение Цикл
		
		НайденнаяСтрока = Объект.Товары.Найти(ВыбранныйТовар, "Товар");
		
		Если НайденнаяСтрока = Неопределено Тогда
			
			НоваяСтрока = Объект.Товары.Добавить();
			НоваяСтрока.Товар = ВыбранныйТовар;
			НоваяСтрока.Количество = 1;
			
			// Берем себестоимость из структуры, полученной с сервера (или 0, если остатков нет)
			УдельнаяСебестоимость = ?(Себестоимости.Свойство(ВыбранныйТовар), 
			Себестоимости.Получить(ВыбранныйТовар), 0);
			
			НоваяСтрока.Стоимость = УдельнаяСебестоимость;
			ПересчитатьЦенуИСуммуСтроки(НоваяСтрока); // Исправлено имя функции
			
		Иначе
			
			// Если товар уже есть, просто увеличиваем количество
			НайденнаяСтрока.Количество = НайденнаяСтрока.Количество + 1;
			// При изменении количества сумма пересчитается автоматически через событие ПриИзменении
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры 

&НаКлиенте
Процедура ТоварыТоварПриИзменении(Элемент)
	
	ЗаполнитьСтоимостьИЦенуСтроки(Элементы.Товары.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыСтоимостьПриИзменении(Элемент)
	
	ПересчитатьЦенуИСуммуСтроки(Элементы.Товары.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	
	ПересчитатьСуммуСтроки(Элементы.Товары.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыЦенаПриИзменении(Элемент)
	
	ПересчитатьСуммуСтроки(Элементы.Товары.ТекущиеДанные);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ДобавитьСтрокуИзПодбора(ВыбранныйТовар)
	
	НоваяСтрока = Объект.Товары.Добавить();
	НоваяСтрока.Товар = ВыбранныйТовар;
	НоваяСтрока.Количество = 1;
	
	ЗаполнитьСтоимостьИЦенуСтроки(НоваяСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСтоимостьИЦенуСтроки(СтрокаТабличнойЧасти)
	
	Если СтрокаТабличнойЧасти = Неопределено 
		Или Не ЗначениеЗаполнено(СтрокаТабличнойЧасти.Товар) Тогда
		Возврат;
	КонецЕсли;
	
	ДатаРасчета = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДата());
	
	// Эта функция остается для ручного ввода товара в строку (по одному)
	СтрокаТабличнойЧасти.Стоимость = ПолучитьСтоимостьПервойПартииНаСервере(
	СтрокаТабличнойЧасти.Товар, 
	ДатаРасчета
	);
	
	ПересчитатьЦенуИСуммуСтроки(СтрокаТабличнойЧасти);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПроцентНаценкиНаСервере()
	Возврат Константы.ПроцентНаценки.Получить();
КонецФункции

&НаКлиенте
Процедура ПересчитатьЦенуИСуммуСтроки(СтрокаТабличнойЧасти)
	
	Если СтрокаТабличнойЧасти = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПроцентНаценки = ПолучитьПроцентНаценкиНаСервере();
	КоэффициентНаценки = 1 + ПроцентНаценки / 100;
	СтрокаТабличнойЧасти.Цена = Окр(СтрокаТабличнойЧасти.Стоимость * КоэффициентНаценки, 2);
	
	ПересчитатьСуммуСтроки(СтрокаТабличнойЧасти);
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСуммуСтроки(СтрокаТабличнойЧасти)
	
	Если СтрокаТабличнойЧасти = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаТабличнойЧасти.Сумма = СтрокаТабличнойЧасти.Количество * СтрокаТабличнойЧасти.Цена;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСебестоимостиТоваровНаСервере(МассивТоваров)
	Возврат ПолучитьСебестоимостиТоваров(МассивТоваров);
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСебестоимостиТоваров(МассивТоваров)
	
	Если МассивТоваров.Количество() = 0 Тогда
		Возврат Новый Структура;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПартииТоваров.Товар КАК Товар,
	|	МИНИМУМ(ПартииТоваров.Партия.Дата) КАК ДатаПервойПартии,
	|	ПартииТоваров.СебестоимостьОстаток / ПартииТоваров.КоличествоОстаток КАК УдельнаяСебестоимость
	|ИЗ
	|	РегистрНакопления.ПартииТоваров.Остатки(&Дата, Товар В(&Товары)) КАК ПартииТоваров
	|ГДЕ
	|	ПартииТоваров.КоличествоОстаток > 0
	|СГРУППИРОВАТЬ ПО
	|	ПартииТоваров.Товар,
	|	ПартииТоваров.СебестоимостьОстаток,
	|	ПартииТоваров.КоличествоОстаток
	|УПОРЯДОЧИТЬ ПО
	|	ПартииТоваров.Товар,
	|	ДатаПервойПартии ВОЗР";
	
	Запрос.УстановитьПараметр("Дата", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Товары", МассивТоваров);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	// Собираем результат в структуру: Ключ = Товар, Значение = Себестоимость
	Себестоимости = Новый Структура;
	Пока РезультатЗапроса.Следующий() Цикл
		ТоварКлюч = РезультатЗапроса.Товар;
		// Вставляем только если еще не вставили (гарантирует взятие самой ранней партии при группировке)
		Если Не Себестоимости.Свойство(ТоварКлюч) Тогда
			Себестоимости.Вставить(ТоварКлюч, РезультатЗапроса.УдельнаяСебестоимость);
		КонецЕсли;
	КонецЦикла;
	
	Возврат Себестоимости;
	
КонецФункции

// оставлена для ручного ввода одной строки  
&НаСервереБезКонтекста
Функция ПолучитьСтоимостьПервойПартииНаСервере(ТоварСсылка, ДатаДокумента)
	
	ПартииЗапрос = Новый Запрос;
	ПартииЗапрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ПартииТоваровОстатки.КоличествоОстаток КАК Количество,
	|	ПартииТоваровОстатки.СебестоимостьОстаток КАК Себестоимость
	|ИЗ
	|	РегистрНакопления.ПартииТоваров.Остатки(&Дата, Товар = &Товар) КАК ПартииТоваровОстатки
	|ГДЕ
	|	ПартииТоваровОстатки.КоличествоОстаток > 0
	|УПОРЯДОЧИТЬ ПО
	|	ПартииТоваровОстатки.Партия.Дата ВОЗР,
	|	ПартииТоваровОстатки.Партия ВОЗР";
	
	ПартииЗапрос.УстановитьПараметр("Дата", ДатаДокумента);
	ПартииЗапрос.УстановитьПараметр("Товар", ТоварСсылка);
	
	ВыборкаПартий = ПартииЗапрос.Выполнить().Выбрать();
	Если ВыборкаПартий.Следующий() Тогда
		Возврат Окр(ВыборкаПартий.Себестоимость / ВыборкаПартий.Количество, 2);
	КонецЕсли;
	
	Возврат 0;
	
КонецФункции

#КонецОбласти