#Область ОписаниеПеременных

&НаКлиенте
Перем КэшПроцентНаценки; // Кэшируем значение константы, чтобы не делать серверные вызовы в цикле

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Подбор(Команда)
	
	ПараметрыФормы = Новый Структура("ЗакрыватьПриВыборе, МножественныйВыбор", Ложь, Истина);
	ОткрытьФорму("Справочник.Товары.ФормаВыбора", ПараметрыФормы, Элементы.Товары);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ТоварыОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	// Приводим выбранное значение к массиву на случай одиночного выбора
	МассивВыбранных = Новый Массив;
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда
		МассивВыбранных = ВыбранноеЗначение;
	Иначе
		МассивВыбранных.Добавить(ВыбранноеЗначение);
	КонецЕсли;
	
	// 1. Собираем массив уникальных товаров
	МассивУникальныхТоваров = Новый Массив;
	Для Каждого ВыбранныйТовар Из МассивВыбранных Цикл
		Если МассивУникальныхТоваров.Найти(ВыбранныйТовар) = Неопределено Тогда
			МассивУникальныхТоваров.Добавить(ВыбранныйТовар);
		КонецЕсли;
	КонецЦикла;
	
	// 2. ОДИН серверный вызов для получения себестоимостей всех товаров
	ДатаРасчета = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДата());
	Себестоимости = ПолучитьСебестоимостиТоваровНаСервере(МассивУникальныхТоваров, ДатаРасчета);
	
	// 3. На клиенте заполняем строки без обращения к серверу
	Для Каждого ВыбранныйТовар Из МассивВыбранных Цикл
		
		НайденнаяСтрока = Объект.Товары.Найти(ВыбранныйТовар, "Товар");
		
		Если НайденнаяСтрока = Неопределено Тогда
			
			НоваяСтрока = Объект.Товары.Добавить();
			НоваяСтрока.Товар = ВыбранныйТовар;
			НоваяСтрока.Количество = 1;
			
			УдельнаяСебестоимость = Себестоимости.Получить(ВыбранныйТовар);
			Если УдельнаяСебестоимость = Неопределено Тогда
				УдельнаяСебестоимость = 0;
			КонецЕсли;
			
			НоваяСтрока.Стоимость = УдельнаяСебестоимость;
			ПересчитатьЦенуИСуммуСтроки(НоваяСтрока);
			
		Иначе
			
			// При программном изменении событие ПриИзменении НЕ срабатывает, пересчитываем явно
			НайденнаяСтрока.Количество = НайденнаяСтрока.Количество + 1;
			ПересчитатьСуммуСтроки(НайденнаяСтрока);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры 

&НаКлиенте
Процедура ТоварыТоварПриИзменении(Элемент)
	
	ЗаполнитьСтоимостьИЦенуСтроки(Элементы.Товары.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыСтоимостьПриИзменении(Элемент)
	
	ПересчитатьЦенуИСуммуСтроки(Элементы.Товары.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыКоличествоПриИзменении(Элемент)
	
	ПересчитатьСуммуСтроки(Элементы.Товары.ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура ТоварыЦенаПриИзменении(Элемент)
	
	ПересчитатьСуммуСтроки(Элементы.Товары.ТекущиеДанные);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ЗаполнитьСтоимостьИЦенуСтроки(СтрокаТабличнойЧасти)
	
	Если СтрокаТабличнойЧасти = Неопределено 
		Или Не ЗначениеЗаполнено(СтрокаТабличнойЧасти.Товар) Тогда
		Возврат;
	КонецЕсли;
	
	ДатаРасчета = ?(ЗначениеЗаполнено(Объект.Дата), Объект.Дата, ТекущаяДата());
	
	МассивТоваров = Новый Массив;
	МассивТоваров.Добавить(СтрокаТабличнойЧасти.Товар);
	
	Себестоимости = ПолучитьСебестоимостиТоваровНаСервере(МассивТоваров, ДатаРасчета);
	УдельнаяСебестоимость = Себестоимости.Получить(СтрокаТабличнойЧасти.Товар);
	
	СтрокаТабличнойЧасти.Стоимость = ?(УдельнаяСебестоимость = Неопределено, 0, УдельнаяСебестоимость);
	ПересчитатьЦенуИСуммуСтроки(СтрокаТабличнойЧасти);
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьЦенуИСуммуСтроки(СтрокаТабличнойЧасти)
	
	Если СтрокаТабличнойЧасти = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Обращаемся к серверу за константой только 1 раз за все время работы с формой
	Если КэшПроцентНаценки = Неопределено Тогда
		КэшПроцентНаценки = ПолучитьПроцентНаценкиНаСервере();
	КонецЕсли;
	
	КоэффициентНаценки = 1 + КэшПроцентНаценки / 100;
	СтрокаТабличнойЧасти.Цена = Окр(СтрокаТабличнойЧасти.Стоимость * КоэффициентНаценки, 2);
	
	ПересчитатьСуммуСтроки(СтрокаТабличнойЧасти);
	
КонецПроцедуры

&НаКлиенте
Процедура ПересчитатьСуммуСтроки(СтрокаТабличнойЧасти)
	
	Если СтрокаТабличнойЧасти = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Используем ваш общий модуль, как было задумано в конце старого файла
	РаботаСДокументами.РассчитатьСумму(СтрокаТабличнойЧасти);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПроцентНаценкиНаСервере()
	
	Возврат Константы.ПроцентНаценки.Получить();
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСебестоимостиТоваровНаСервере(МассивТоваров, ДатаРасчета)
	
	// Используем Соответствие вместо Структуры, так как ключом является СправочникСсылка
	Себестоимости = Новый Соответствие;
	
	Если МассивТоваров.Количество() = 0 Тогда
		Возврат Себестоимости;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПартииТоваров.Товар КАК Товар,
		|	ПартииТоваров.Партия.Дата КАК ДатаПартии,
		|	ПартииТоваров.СебестоимостьОстаток / ПартииТоваров.КоличествоОстаток КАК УдельнаяСебестоимость
		|ИЗ
		|	РегистрНакопления.ПартииТоваров.Остатки(&Дата, Товар В(&Товары)) КАК ПартииТоваров
		|ГДЕ
		|	ПартииТоваров.КоличествоОстаток > 0
		|УПОРЯДОЧИТЬ ПО
		|	ПартииТоваров.Товар,
		|	ДатаПартии ВОЗР,
		|	ПартииТоваров.Партия ВОЗР";
	
	Запрос.УстановитьПараметр("Дата", ДатаРасчета);
	Запрос.УстановитьПараметр("Товары", МассивТоваров);
	
	РезультатЗапроса = Запрос.Выполнить().Выбрать();
	
	Пока РезультатЗапроса.Следующий() Цикл
		ТоварКлюч = РезультатЗапроса.Товар;
		Если Себестоимости.Получить(ТоварКлюч) = Неопределено Тогда
			Себестоимости.Вставить(ТоварКлюч, Окр(РезультатЗапроса.УдельнаяСебестоимость, 2));
		КонецЕсли;
	КонецЦикла;
	
	Возврат Себестоимости;
	
КонецФункции

#КонецОбласти
