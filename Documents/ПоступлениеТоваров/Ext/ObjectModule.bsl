
#Область ОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ, Режим) 
	
	
	#Область ИнициализацияДвижений
	
	Движения.ОстаткиТоваров.Записывать = Истина;
	Движения.СтоимостьМатериалов.Записывать = Истина;
	Движения.ПартииТоваров.Записывать = Истина; 
	
	#КонецОбласти
	
	#Область ФормированиеДвижений
	
	Для Каждого ТекСтрокаТовары Из Товары Цикл
		
		// регистр ОстаткиТоваров Приход
		Движение = Движения.ОстаткиТоваров.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Товар = ТекСтрокаТовары.Товар;
		Движение.Количество = ТекСтрокаТовары.Количество;
		
		// регистр СтоимостьМатериалов Приход
		Движение = Движения.СтоимостьМатериалов.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.Товар = ТекСтрокаТовары.Товар;
		Движение.Стоимость = ТекСтрокаТовары.Сумма;
		
		// регистр ПартииТоваров
		ДвижениеПартии = Движения.ПартииТоваров.Добавить();
		ДвижениеПартии.ВидДвижения = ВидДвиженияНакопления.Приход;
		ДвижениеПартии.Период = Дата; 
		ДвижениеПартии.Товар = ТекСтрокаТовары.Товар;
		ДвижениеПартии.Партия = Ссылка;
		ДвижениеПартии.Количество = ТекСтрокаТовары.Количество;
		ДвижениеПартии.Себестоимость = ТекСтрокаТовары.Сумма;
	КонецЦикла;
	
	#КонецОбласти
	
КонецПроцедуры

#КонецОбласти